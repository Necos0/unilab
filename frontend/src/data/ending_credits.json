      "text": "<head>"
    },
    {
      "kind": "tag",
      "x": 122,
      "text": "<title>ユニラブ</title>"
    },
    {
      "kind": "tag",
      "x": 80,
      "text": "</head>"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 80,
      "text": "<body>"
    },
    {
      "kind": "comment",
      "x": 112,
      "text": "<!-- グレーの 行《ぎょう》には のれないよ! -->"
    },
    {
      "kind": "tag",
      "x": 112,
      "text": "<credits>"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 144,
      "text": "<section class=\"ならったこと\">"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "text",
      "x": 176,
      "text": "フローチャート …… カードを じゅんばんに ながす"
    },
    {
      "kind": "text",
      "x": 641,
      "text": "条件《じょうけん》マス (if) …… はい / いいえ で みちが わかれる"
    },
    {
      "kind": "text",
      "x": 67,
      "text": "カウントマス (for) …… おなじ ところを くりかえす"
    },
    {
      "kind": "text",
      "x": 297,
      "text": "倍率《ばいりつ》マス …… カードの 効果《こうか》が 倍《ばい》になる"
    },
    {
      "kind": "text",
      "x": 507,
      "text": "種類指定《しゅるいしてい》マス …… きまった カードだけ はいる"
    },
    {
      "kind": "text",
      "x": 893,
      "text": "パワーアップマス …… とおるたびに つよくなる"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 144,
      "text": "</section>"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 144,
      "text": "<section class=\"キャスト\">"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "text",
      "x": 152,
      "text": "ゆうしゃ 役《やく》 …… {playerName}",
      "sprite": "/sprites/hero/idle/hero_idle_00.png"
    },
    {
      "kind": "text",
      "x": 838,
      "text": "ゆうしゃのあいぼう 役《やく》 …… ビット",
      "sprite": "/sprites/robo/robo.png"
    },
    {
      "kind": "text",
      "x": 954,
      "text": "スライム　役《やく》 …… どじゃーすぶるー",
      "sprite": "/sprites/enemies/slime/idle/slime_idle_00.png"
    },
    {
      "kind": "text",
      "x": 1064,
      "text": "ウルフ 役《やく》 …… でこぴん",
      "sprite": "/sprites/enemies/wolf/idle/wolf_idle_00.png"
    },
    {
      "kind": "text",
      "x": 984,
      "text": "ナイト 役《やく》 …… エルリックメタル",
      "sprite": "/sprites/enemies/knight/idle/knight_idle_00.png"
    },
    {
      "kind": "text",
      "x": 839,
      "text": "ゴーレム 役《やく》 …… ハードえんぴつ",
      "sprite": "/sprites/enemies/golem/idle/golem_idle_00.png"
    },
    {
      "kind": "text",
      "x": 692,
      "text": "サボテン 役《やく》 …… エースワン",
      "sprite": "/sprites/enemies/cactus/idle/cactus_idle_00.png"
    },
    {
      "kind": "text",
      "x": 417,
      "text": "サソリ 役《やく》 …… デイダラブラザー",
      "sprite": "/sprites/enemies/scorpion/idle/scorpion_idle_00.png"
    },
    {
      "kind": "text",
      "x": 1064,
      "text": "コブラ 役《やく》 …… ダイナマイトアナコンダ",
      "sprite": "/sprites/enemies/cobra/idle/cobra_idle_00.png"
    },
    {
      "kind": "text",
      "x": 867,
      "text": "ゴールデンバード 役《やく》 …… ばななミラクル",
      "sprite": "/sprites/enemies/goldenbird/idle/goldenbird_idle_00.png"
    },
    {
      "kind": "text",
      "x": 672,
      "text": "ヒトデ 役《やく》 …… スタージェット",
      "sprite": "/sprites/enemies/starfish/idle/starfish_idle_00.png"
    },
    {
      "kind": "text",
      "x": 470,
      "text": "イカ 役《やく》 …… クラーケン",
      "sprite": "/sprites/enemies/squid/idle/squid_idle_00.png"
    },
    {
      "kind": "text",
      "x": 165,
      "text": "サメ 役《やく》 …… フィジーオーシャン",
      "sprite": "/sprites/enemies/shark/idle/shark_idle_00.png"
    },
    {
      "kind": "text",
      "x": 674,
      "text": "青龍 役 …… 龍崎",
      "sprite": "/sprites/enemies/lagiacrus/idle/lagiacrus_idle_00.png"
    },
    {
      "kind": "text",
      "x": 368,
      "text": "カニ 役 …… 仁力ィ",
      "sprite": "/sprites/enemies/crab/idle/crab_idle_00.png"
    },
    {
      "kind": "text",
      "x": 1018,
      "text": "トカゲ 役 …… DAPPI★",
      "sprite": "/sprites/enemies/lizard/idle/lizard_idle_00.png"
    },
    {
      "kind": "text",
      "x": 181,
      "text": "フェニックス 役 …… まるお",
      "sprite": "/sprites/enemies/phoenix/idle/phoenix_idle_00.png"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "text",
      "x": 123,
      "text": "ドラゴン 役…… ドラム弟",
      "sprite": "/sprites/enemies/dragon/idle/dragon_idle_00.png"
    },
    {
      "kind": "text",
      "x": 378,
      "text": "しんのドラゴン 役…… ドラム兄",
      "sprite": "/sprites/enemies/dragon_final/idle/dragon_final_idle_00.png"
    },
    {
      "kind": "tag",
      "x": 852,
      "text": "↑　　　　　　　　　　　　　　</section>"
    },
    {
      "kind": "tag",
      "x": 506,
      "text": "<section class=\"きみの ぼうけんの きろく\">"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "text",
      "x": 173,
      "text": "クリアした ステージ …… {clearedCount} / {stageTotal}"
    },
    {
      "kind": "text",
      "x": 700,
      "text": "であった カード …… {cardCount} しゅるい"
    },
    {
      "kind": "text",
      "x": 383,
      "text": "さいごの ボス …… ドラゴン"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 144,
      "text": "</section>"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 144,
      "text": "<section class=\"つかった どうぐ\">"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "text",
      "x": 175,
      "text": "JavaScript …… プログラムの ことば"
    },
    {
      "kind": "text",
      "x": 555,
      "text": "React …… がめんを つくる どうぐ"
    },
    {
      "kind": "text",
      "x": 149,
      "text": "Vite …… アプリを うごかす どうぐ"
    },
    {
      "kind": "text",
      "x": 873,
      "text": "Zustand …… データを おぼえておく どうぐ"
    },
    {
      "kind": "comment",
      "x": 176,
      "text": "<!-- この ゲームも プログラミングで できているよ -->"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 226,
      "text": "</section>"
    },
    {
      "kind": "blank"
