      "text": "<section class=\"ならったこと\">"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "text",
      "x": 176,
      "text": "フローチャート …… カードを じゅんばんに ながす"
    },
    {
      "kind": "text",
      "x": 272,
      "text": "条件《じょうけん》マス (if) …… はい / いいえ で みちが わかれる"
    },
    {
      "kind": "text",
      "x": 368,
      "text": "カウントマス (for) …… おなじ ところを くりかえす"
    },
    {
      "kind": "text",
      "x": 176,
      "text": "倍率《ばいりつ》マス …… カードの 効果《こうか》が 倍《ばい》になる"
    },
    {
      "kind": "text",
      "x": 272,
      "text": "種類指定《しゅるいしてい》マス …… きまった カードだけ はいる"
    },
    {
      "kind": "text",
      "x": 368,
      "text": "パワーアップマス …… とおるたびに つよくなる"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 144,
      "text": "</section>"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "tag",
      "x": 144,
      "text": "<section class=\"キャスト\">"
    },
    {
      "kind": "blank"
    },
    {
      "kind": "text",
      "x": 176,
      "text": "ゆうしゃ 役《やく》 …… {playerName}",
