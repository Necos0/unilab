      { "bubble": "この『ひっさつカード』を マスに はめてみて！", "point": "finisherCard", "waitForCardInSlot": true },
      { "bubble": "このフローチャートは 無限《むげん》ループ！倒《たお》すまで 攻撃《こうげき》し続《つづ》けるよ。じっこうだ、{playerName}！！", "point": "executeButton", "waitForExecute": true }
    ]
  },
  "runaway-blocked": {
    "category": "help",
    "once": false,
    "trigger": { "type": "runawayBlocked" },
    "steps": [
