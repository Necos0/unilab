  "stage4-4-revive": {
    "category": "story",
    "once": false,
    "trigger": { "type": "bossRevive", "stageId": "4-4" },
    "steps": [
      { "bubble": "そ、そんな…！？ 倒《たお》したはずなのに、立《た》ち上《あ》がってくる…！" },
      { "bubble": "HPが 9999…！？ こんなの、ふつうに 戦《たたか》ったら 勝《か》てないよ…！" },
      { "bubble": "…ううん、あきらめない。{playerName}と ここまで 来《き》たんだ。ぼくの 全部《ぜんぶ》の 力《ちから》を 使《つか》うよ！" },
